# Copy to .env.production (git-ignored). Read by `pnpm build` only, NOT by `pnpm dev`, so analytics stay off in development.
# Base URL of the web app that owns /api/analytics. Leave empty (or delete the line) to build with analytics disabled.
# Must be https:// and your real deployed address. `pnpm release:apk` refuses to build an APK without it (ALLOW_NO_ANALYTICS=1 overrides).
NEXT_PUBLIC_ANALYTICS_URL=https://your-web-app.example
NEXT_PUBLIC_APK_URL=direct link to Clinexia-3.0.0.apk
NEXT_PUBLIC_APK_SHA256=your_long_string_secret_here
NEXT_PUBLIC_APK_VERSION=version_number
# Optional. Tags the rows sent by this build (default: "production" for release builds, "development" otherwise).
# NEXT_PUBLIC_APP_ENV=production
